# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — used by privileged routes (e.g. /api/invite/[token])
# to bypass RLS for join operations. Optional: falls back to anon key if unset,
# but production deployments should set this for proper auth boundaries.
# NEVER expose this to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Anthropic — Claude Haiku for slideshow storyboard generation (PROJ-34)
# Server-side only. Never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Add more environment variables as needed
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
